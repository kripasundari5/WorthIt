# Copy this file to .env and fill in credentials only on your own machine.
# Local Python / Streamlit execution:
DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tradeoff
DB_PASSWORD=postgres

# Required only to fetch live Flipkart data through ReefAPI.
REEF_API_KEY=

# Optional: leave blank to use the local keyword-based query parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Ranking defaults. FLOOR_GUARD stays off for the primary evaluation.
FLOOR_PERCENTILE=35
FLOOR_LAMBDA=3.0
PRIORITY_GAMMA=0.7
MIN_MENTIONS=1
USE_PRICE_EFFICIENCY=1
PRICE_WEIGHT=0.20
FLOOR_GUARD=0
ABSA_BACKEND=lexicon
